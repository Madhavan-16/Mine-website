FLASK_SECRET_KEY=change-me-in-production
DATABASE_PATH=mine.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# --- Azure App Service (production) ---
# Set FLASK_SECRET_KEY in Portal → Configuration → Application settings (not in committed .env).
# General settings → Startup Command: bash startup.sh
# Commit mine.db + uploads/ to git so local content deploys with the app — see docs/azure-deploy.md

# Optional: path to Freeport active resource tracker (default: data/Freeport active resource Tracker - Updated.xlsx)
# TEAM_ROSTER_XLSX=data/Freeport active resource Tracker - Updated.xlsx

# LibreOffice (optional) — PDF previews for PowerPoint/Word uploads via headless soffice.
# Install: .\scripts\setup_libreoffice.ps1  |  Backfill: python scripts/backfill_attachment_previews.py
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# BACKFILL_ATTACHMENT_PREVIEWS=1
# ENABLE_SLIDE_PREVIEW=1
# SLIDE_PREVIEW_SCALE=2.0

# --- Outbound mail ---
# Option A — local/dev without any SMTP server (messages appended to logs/mail-outbox.log):
# MAIL_ENABLED=1
# MAIL_DUMMY=1
# MAIL_DEFAULT_SENDER="MiNe Dev <noreply@mine.local>"
#
# Option B — real SMTP (set MAIL_DUMMY=0 or remove it). Example Microsoft 365 submission client:
# MAIL_ENABLED=1
# MAIL_DUMMY=0
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_USERNAME=your-mailbox@company.com
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER="MiNe <your-mailbox@company.com>"
#
# Optional override for dummy mailbox path (default: logs/mail-outbox.log under the project).
# MAIL_DUMMY_PATH=
# MAIL_SMTP_TIMEOUT=30
# Optional: also email admins/moderators when something hits the moderation queue (in addition to in-app notify).
# MAIL_NOTIFY_ON_PENDING=0
# Optional: comma-separated extra addresses when MAIL_OPEN_RECIPIENTS=0 (MiNe-only lockdown).
# MAIL_EXTRA_ALLOWLIST=
# When 0/false/no, admin "Send email" is limited to active MiNe users + MAIL_EXTRA_ALLOWLIST. Default (unset) allows any valid address.
# MAIL_OPEN_RECIPIENTS=1
# Verbose SMTP wire log to stderr (development/troubleshooting only).
# MAIL_SMTP_DEBUG=0

# --- Microsoft Graph mailbox integration (OAuth2, no SMTP passwords) ---
# Enable admin mailbox pages under /admin/mailbox/*
# MS_GRAPH_ENABLED=1
# App registration (Microsoft Entra ID / Azure AD)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# Use "common" for organization + personal Microsoft accounts; set tenant GUID for single-tenant.
# MS_TENANT=common
# Must match redirect URI configured in your app registration.
# MS_REDIRECT_PATH=/admin/mailbox/oauth/callback
# Base64 Fernet key for token encryption at rest (generate once and keep secret).
# Example generator:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MS_TOKEN_ENCRYPTION_KEY=
# Optional scope override (comma-separated)
# MS_GRAPH_SCOPES=openid,profile,offline_access,User.Read,Mail.ReadWrite,Mail.Send

# --- SharePoint / Teams training folder for Ask MiNe ---
# Application permissions required (admin consent): Files.Read.All or Sites.Read.All
# MS_TENANT must be the Hexaware directory GUID (not "common").
# SHAREPOINT_KB_ENABLED=1
# SHAREPOINT_KB_FOLDER_URL=https://hexawareonline.sharepoint.com/:f:/s/FMIOFFSHORE/IgAVjdYkVIhuTpBRwsMxmzBbAYvl6_aw5mh3NClZM1pxCVo
# SHAREPOINT_KB_SYNC_ON_STARTUP=0
# SHAREPOINT_KB_SYNC_INTERVAL_HOURS=6
# SHAREPOINT_KB_MAX_FILES=200
# SHAREPOINT_KB_MAX_FILE_MB=25
# Optional: local mirror of the Teams folder (works without Graph)
# SHAREPOINT_KB_LOCAL_DIR=data/teams_training
# See docs/sharepoint-kb-setup.md

# Knowledge chatbot
# CHATBOT_ENABLED=1
# Free-tier LLM: auto (prefer Groq if key set, else Gemini) | groq | gemini | none
# CHATBOT_LLM_PROVIDER=auto
# GROQ_API_KEY=   # https://console.groq.com
# GEMINI_API_KEY= # https://aistudio.google.com/apikey
# Optional model override (defaults: llama-3.1-8b-instant / gemini-2.0-flash)
# CHATBOT_LLM_MODEL=
# CHATBOT_LLM_TIMEOUT=45
